###########################
# LOCAL ADDITIONS         #
###########################
# Append this file to .env.sample (see CHANGES.md): `cat .env.sample .env.local.sample > .env`
# A name defined twice takes the LAST value, so these lines override the sample's.

# Keeps the existing volumes of this server (.env.sample says "xtm")
COMPOSE_PROJECT_NAME=opencti

# One version for the platform, the worker and every connector. Change it here to upgrade.
OPENCTI_VERSION=

# OpenSearch used as the search backend (see CHANGES.md): its address and the password of its
# "opencti" user. The CA certificate goes to certs/opensearch-ca.pem
OPENSEARCH_URL=
OPENSEARCH_OPENCTI_PASSWORD=

# Connector ids: one new UUIDv4 each (uuidgen), never reused, never changed afterwards
CONNECTOR_ABUSE_SSL_ID=
CONNECTOR_CISA_KEV_ID=
CONNECTOR_DISARM_FRAMEWORK_ID=
CONNECTOR_DNSTWIST_ID=
CONNECTOR_DSHIELD_ID=
CONNECTOR_FIRST_EPSS_BULK_ID=
CONNECTOR_HYGIENE_ID=
CONNECTOR_IPSUM_ID=
CONNECTOR_MALPEDIA_ID=
CONNECTOR_MITRE_ATLAS_ID=
CONNECTOR_RANSOMFEED_ID=
CONNECTOR_RANSOMWARELIVE_ID=
CONNECTOR_RED_FLAG_DOMAINS_ID=
CONNECTOR_SHODAN_INTERNETDB_ID=
CONNECTOR_THREATFOX_ID=
CONNECTOR_TWEETFEED_ID=
CONNECTOR_URLHAUS_ID=
